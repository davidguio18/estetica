generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["audit", "auth", "inventory"]
}

model audit_logs {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   String?  @db.Uuid
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_audit_logs_user")

  @@index([action], map: "idx_audit_logs_action")
  @@index([created_at], map: "idx_audit_logs_created_at")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([user_id], map: "idx_audit_logs_user_id")
  @@schema("audit")
}

model password_reset_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique(map: "uq_password_reset_tokens_token_hash")
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_reset_tokens_user")

  @@index([expires_at], map: "idx_password_reset_tokens_expires_at")
  @@index([user_id], map: "idx_password_reset_tokens_user_id")
  @@schema("auth")
}

model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique(map: "uq_permissions_code") @db.VarChar(150)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]

  @@schema("auth")
}

model refresh_tokens {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String           @db.Uuid
  token_hash           String           @unique(map: "uq_refresh_tokens_token_hash")
  expires_at           DateTime         @db.Timestamptz(6)
  revoked_at           DateTime?        @db.Timestamptz(6)
  replaced_by_token_id String?          @db.Uuid
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  refresh_tokens       refresh_tokens?  @relation("refresh_tokensTorefresh_tokens", fields: [replaced_by_token_id], references: [id], onUpdate: NoAction, map: "fk_refresh_tokens_replaced_by")
  other_refresh_tokens refresh_tokens[] @relation("refresh_tokensTorefresh_tokens")
  users                users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_tokens_user")

  @@index([expires_at], map: "idx_refresh_tokens_expires_at")
  @@index([revoked_at], map: "idx_refresh_tokens_revoked_at")
  @@index([user_id], map: "idx_refresh_tokens_user_id")
  @@schema("auth")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  assigned_at   DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "idx_role_permissions_permission_id")
  @@schema("auth")
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique(map: "uq_roles_name") @db.VarChar(100)
  description      String?
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  user_roles       user_roles[]

  @@schema("auth")
}

model user_roles {
  user_id     String   @db.Uuid
  role_id     String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  roles       roles    @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_role")
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user")

  @@id([user_id, role_id])
  @@index([role_id], map: "idx_user_roles_role_id")
  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username              String                  @unique(map: "uq_users_username") @db.VarChar(100)
  email                 String                  @unique(map: "uq_users_email") @db.VarChar(255)
  password_hash         String
  first_name            String                  @db.VarChar(100)
  last_name             String                  @db.VarChar(100)
  is_active             Boolean                 @default(true)
  password_changed_at   DateTime?               @db.Timestamptz(6)
  last_login_at         DateTime?               @db.Timestamptz(6)
  failed_login_attempts Int                     @default(0)
  locked_until          DateTime?               @db.Timestamptz(6)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  audit_logs            audit_logs[]
  password_reset_tokens password_reset_tokens[]
  refresh_tokens        refresh_tokens[]
  user_roles            user_roles[]
  inventory_movements   inventory_movements[]

  @@index([email], map: "idx_users_email")
  @@index([is_active], map: "idx_users_is_active")
  @@index([username], map: "idx_users_username")
  @@schema("auth")
}

model categories {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique(map: "uq_categories_name") @db.VarChar(150)
  description String?
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  products    products[]

  @@schema("inventory")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_movements {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id        String          @db.Uuid
  movement_type   movement_type
  quantity        Decimal         @db.Decimal(12, 2)
  reference       String?
  notes           String?
  performed_by    String          @db.Uuid
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  product_batches product_batches @relation(fields: [batch_id], references: [id], onUpdate: NoAction, map: "fk_inventory_movements_batch")
  users           users           @relation(fields: [performed_by], references: [id], onUpdate: NoAction, map: "fk_inventory_movements_user")

  @@index([batch_id], map: "idx_inventory_movements_batch_id")
  @@index([created_at], map: "idx_inventory_movements_created_at")
  @@index([performed_by], map: "idx_inventory_movements_performed_by")
  @@schema("inventory")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_batches {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String                @db.Uuid
  supplier_id         String?               @db.Uuid
  batch_number        String                @db.VarChar(100)
  manufacturing_date  DateTime?             @db.Date
  expiration_date     DateTime              @db.Date
  purchase_price      Decimal?              @db.Decimal(14, 2)
  initial_quantity    Decimal               @db.Decimal(12, 2)
  current_quantity    Decimal               @db.Decimal(12, 2)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]
  products            products              @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_product_batches_product")
  suppliers           suppliers?            @relation(fields: [supplier_id], references: [id], onUpdate: NoAction, map: "fk_product_batches_supplier")

  @@unique([product_id, batch_number], map: "uq_product_batches_product_batch")
  @@index([expiration_date], map: "idx_product_batches_expiration_date")
  @@index([product_id], map: "idx_product_batches_product_id")
  @@index([supplier_id], map: "idx_product_batches_supplier_id")
  @@schema("inventory")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id     String            @db.Uuid
  sku             String            @unique(map: "uq_products_sku") @db.VarChar(100)
  name            String            @db.VarChar(200)
  description     String?
  brand           String?           @db.VarChar(150)
  unit_of_measure String            @default("UNIT") @db.VarChar(50)
  minimum_stock   Decimal           @default(0) @db.Decimal(12, 2)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  product_batches product_batches[]
  categories      categories        @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_products_category")

  @@index([category_id], map: "idx_products_category_id")
  @@index([is_active], map: "idx_products_is_active")
  @@schema("inventory")
}

model suppliers {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(200)
  tax_id          String?           @db.VarChar(50)
  phone           String?           @db.VarChar(50)
  email           String?           @db.VarChar(255)
  address         String?
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  product_batches product_batches[]

  @@schema("inventory")
}

enum movement_type {
  PURCHASE
  TREATMENT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
  EXPIRED
  DAMAGED

  @@schema("inventory")
}
